{
  "name": "next-portaria",
  "version": "0.7.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "node scripts/run-framework.mjs dev",
    "dev:local": "node scripts/run-framework.mjs dev --hostname 127.0.0.1 --port 5180",
    "start:postgres": "node scripts/run-framework.mjs start --hostname 127.0.0.1 --port 5180",
    "postgres:status": "node --experimental-strip-types scripts/postgres-local.mjs status",
    "postgres:start": "node --experimental-strip-types scripts/postgres-local.mjs start",
    "postgres:stop": "node --experimental-strip-types scripts/postgres-local.mjs stop",
    "postgres:migrate": "node --experimental-strip-types scripts/postgres-local.mjs migrate",
    "backup:postgres": "node --experimental-strip-types scripts/backup-postgres.mjs create --offline",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --experimental-strip-types scripts/application.mjs start",
    "stop": "node --experimental-strip-types scripts/application.mjs stop",
    "status": "node --experimental-strip-types scripts/application.mjs status",
    "backup:full": "node --experimental-strip-types scripts/application.mjs backup",
    "start:secure": "node scripts/start-secure.mjs",
    "lint": "eslint .",
    "lint:stability": "eslint lib/persistence lib/integrations lib/media.ts lib/postgres-backup.mjs scripts/simulate-access-devices.mjs tests/postgres.test.mjs tests/postgres-stability.test.mjs tests/postgres-transactions.test.mjs tests/integration-preparation.test.mjs tests/support/postgres-fixture.mjs",
    "db:generate": "drizzle-kit generate",
    "db:setup": "node --experimental-strip-types scripts/setup-database.mjs",
    "db:admin": "node --experimental-strip-types scripts/create-local-admin.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:hmr": "node tests/e2e-hmr.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "lint:ui": "eslint app/ui.tsx app/app-shell.tsx app/form-steps.tsx app/access-overview.tsx scripts/check-ui.mjs",
    "package:server": "node scripts/package-server.mjs",
    "media:retention": "node --experimental-strip-types scripts/media-retention.mjs",
    "integration:simulate": "node --experimental-strip-types scripts/simulate-access-devices.mjs",
    "check": "tsc --noEmit",
    "demo:local": "node --experimental-strip-types scripts/seed-local-demo.mjs",
    "dev:demo": "vite --config demo/vite.config.ts",
    "build:demo": "vite build --config demo/vite.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "axe-core": "4.14.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.4.4",
    "vite": "8.3.6",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
